HASH_LIMIT = 256 * 1024 * 1024


def read_head(path: str, n: int = 64) -> bytes:
    with open(path, "rb") as fh:
        return fh.read(n)


def sha256_of(path: str, limit: int = HASH_LIMIT) -> str:
    h = hashlib.sha256()
    read = 0
    with open(path, "rb") as fh:
        while True:
            block = fh.read(1024 * 1024)
            if not block or read >= limit:
                break
            h.update(block)
            read += len(block)
    return h.hexdigest()


def entropy(data: bytes) -> float:
    if not data:
        return 0.0
    counts = [0] * 256
    for byte in data:
        counts[byte] += 1
    import math
    total = len(data)
    return -sum((c / total) * math.log2(c / total) for c in counts if c)


def run_external(cmd: list, timeout: int = 60):
    """Run a helper tool, never raising: (ok, output)."""
    if not shutil.which(cmd[0]):
        return False, ""
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return proc.returncode == 0, (proc.stdout or "") + (proc.stderr or "")
    except Exception as exc:  # pragma: no cover - defensive
        return False, f"{cmd[0]}: {exc}"


# ---------------------------------------------------------------------- identity
def elf_info(data: bytes) -> dict:
    info = {}
    if len(data) < 64 or data[:4] != b"\x7fELF":
        return info
    ei_class, ei_data = data[4], data[5]
    info["bits"] = 64 if ei_class == 2 else 32
    little = ei_data == 1
    info["endianness"] = "little" if little else "big"
    end = "<" if little else ">"
    e_type, e_machine = struct.unpack_from(end + "HH", data, 16)
    info["machine"] = {0x3E: "x86-64", 0x03: "i386", 0xB7: "AArch64", 0x28: "ARM",
                       0xF3: "RISC-V", 0x08: "MIPS", 0x14: "PowerPC"}.get(e_machine, f"0x{e_machine:x}")
    info["type"] = {1: "relocatable object", 2: "executable", 3: "shared object (PIE or library)",
                    4: "core dump"}.get(e_type, str(e_type))
    if info["bits"] == 64:
        info["entry"] = struct.unpack_from(end + "Q", data, 24)[0]
        shoff, shentsize, shnum = struct.unpack_from(end + "QH H", data, 40)[0], \
            struct.unpack_from(end + "H", data, 58)[0], struct.unpack_from(end + "H", data, 60)[0]
    else:
        info["entry"] = struct.unpack_from(end + "I", data, 24)[0]
        shoff = struct.unpack_from(end + "I", data, 32)[0]
        shentsize = struct.unpack_from(end + "H", data, 46)[0]
        shnum = struct.unpack_from(end + "H", data, 48)[0]
    info["sections"] = shnum
    info["section_table_offset"] = shoff
    interp = data.find(b"/lib64/ld-linux")
    if interp == -1:
        interp = data.find(b"/lib/ld-linux")
    if interp != -1:
        end_at = data.find(b"\x00", interp)
        info["interpreter"] = data[interp:end_at].decode("ascii", "replace")
    return info


def pe_info(data: bytes) -> dict:
    info = {}
    if len(data) < 0x40 or data[:2] != b"MZ":
        return info
    pe_off = struct.unpack_from("<I", data, 0x3C)[0]
    if data[pe_off:pe_off + 4] != b"PE\x00\x00":
        return info
    machine, num_sections = struct.unpack_from("<HH", data, pe_off + 4)
    info["machine"] = {0x8664: "x86-64", 0x14C: "i386", 0xAA64: "AArch64",
                       0x1C0: "ARM"}.get(machine, f"0x{machine:x}")
    opt_size = struct.unpack_from("<H", data, pe_off + 20)[0]
    opt = pe_off + 24
    magic = struct.unpack_from("<H", data, opt)[0]
    info["pe32"] = "PE32+" if magic == 0x20B else "PE32"
    subsystem = struct.unpack_from("<H", data, opt + 68)[0] if opt_size >= 70 else 0
    info["subsystem"] = {2: "GUI", 3: "console", 1: "native", 9: "Windows CE"}.get(subsystem, str(subsystem))
    dllchar = struct.unpack_from("<H", data, opt + 70)[0] if opt_size >= 72 else 0
    info["aslr"] = bool(dllchar & 0x40)
    # data directories start at opt+96 in PE32+, opt+96 in PE32 too (after the
    # standard+windows fields); the CLR entry is #15
    dd = opt + (112 if magic == 0x20B else 96)
    if len(data) > dd + 15 * 8 + 8:
        clr_rva, clr_size = struct.unpack_from("<II", data, dd + 14 * 8)
        if clr_rva and clr_size:
            info["dotnet"] = True
    info["sections"] = num_sections
    names = []
    off = opt + opt_size
    for _ in range(min(num_sections, 24)):
        raw = data[off:off + 8].split(b"\x00")[0]
        names.append(raw.decode("ascii", "replace"))
        off += 40
    info["section_names"] = names
    if ".NET" in " ".join(names) or info.get("dotnet"):
        info["dotnet"] = True
    return info


def zip_kind(names) -> str:
    joined = "\n".join(names[:400]).lower()
    if "androidmanifest.xml" in joined:
        return "Android APK"
    if "meta-inf/manifest.mf" in joined and any(n.endswith(".class") for n in names):
        return "Java JAR"
    if ".dist-info/" in joined and any(n.endswith(".dist-info/wheel") for n in names):
        return "Python wheel"
    if "meta-inf/manifest.json" in joined and any(n.endswith(".js") for n in names):
        return "browser extension (XPI/CRX)"
    if any(n.startswith("word/") for n in names):
        return "Office document (docx)"
    if "content_types.xml" in joined:
        return "Open XML/ODF package"
    if "index.html" in joined and "assets/" in joined:
        return "web application bundle"
    return "ZIP archive"


def identify(path: str, max_bytes: int) -> dict:
    facts = {"path": os.path.abspath(path)}
    st = os.stat(path)
    facts["size"] = st.st_size
    facts["size_human"] = human(st.st_size)
    facts["mode"] = oct(st.st_mode & 0o7777)
    facts["mtime"] = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(st.st_mtime))
    if os.path.isdir(path):
        facts["kind"] = "directory"
        return facts

    facts["sha256"] = sha256_of(path)
    with open(path, "rb") as fh:
        data = fh.read(min(st.st_size, max_bytes))

    facts["kind"] = "unknown"
    for magic, label in MAGIC:
        if data.startswith(magic):
            facts["kind"] = label
            break
    if data.startswith(b"\xca\xfe\xba\xbe"):
        # java .class and Mach-O fat binaries share this magic; the next uint32
        # decides: a fat binary counts its architectures, a class file has a minor
        # version (almost always 0) followed by a small major version.
        second = struct.unpack_from(">I", data, 4)[0] if len(data) >= 8 else 0
        if 1 <= second <= 25:
            facts["kind"] = "Mach-O universal (fat) binary"
        elif second == 0 and len(data) >= 8:
            facts["kind"] = "Java class file"
        else:
            facts["kind"] = "Java class file (or fat Mach-O)"
        facts["java_second_word"] = second
    if data.startswith(b"\x53\xef") is False and len(data) > 1082 and data[1080:1082] == b"\x53\xef":
        facts["kind"] = "ext2/3/4 filesystem image"

    if looks_like_asar(data):
        facts["kind"] = "Electron ASAR archive"

    if facts["kind"] == "ELF executable/library":
        facts["elf"] = elf_info(data)
    elif facts["kind"].startswith("DOS/PE"):
        facts["pe"] = pe_info(data)

    # packed / high-entropy regions - a packer hides the real code
    regions = []
    block = 4096
    scan = data[: min(len(data), 8 * 1024 * 1024)]
    for off in range(0, len(scan), block):
        ent = entropy(scan[off:off + block])
        if ent > 7.5:
            regions.append(off)
    if regions:
        facts["high_entropy_regions"] = len(regions)
        facts["high_entropy_first"] = regions[0]
    facts["entropy"] = round(entropy(scan[: 1 * 1024 * 1024]), 2) if scan else 0.0

    marks = []
    for needle, why in ((b"UPX!", "UPX packer"), (b"PyInstaller", "PyInstaller bundle"),
                        (b"py2exe", "py2exe bundle"), (b"Go build ID", "Go binary"),
                        (b"rustc", "Rust binary"), (b"mscoree.dll", ".NET runtime"),
                        (b"__libc_start_main", "glibc"), (b"Electron", "Electron/Chromium"),
                        (b"node_modules", "Node.js bundle"), (b"asar", "Electron ASAR"),
                        (b"gzexe", "gzexe"), (b"$Info: This file is packed", "packed installer")):
        if needle in data:
            marks.append(why)
    if marks:
        facts["markers"] = sorted(set(marks))

    if data[:4] in (b"PK\x03\x04", b"PK\x05\x06"):
        try:
            with zipfile.ZipFile(path) as zf:
                names = zf.namelist()
            facts["zip_entries"] = len(names)
            facts["zip_kind"] = zip_kind(names)
            facts["zip_sample"] = names[:12]
        except Exception as exc:
            facts["zip_error"] = str(exc)
    elif data.startswith(b"!<arch>\n"):
        try:
            facts["ar_members"] = ar_members(data)
        except Exception as exc:
            facts["ar_error"] = str(exc)
    return facts


def ar_members(data: bytes) -> list:
    members = []
    off = 8
    while off + 60 <= len(data) and len(members) < 200:
        header = data[off:off + 60]
        if header[58:60] != b"`\n":
            break
        name = header[:16].decode("ascii", "replace").strip()
        size = int(header[48:58].decode("ascii", "replace").strip() or 0)
        members.append({"name": name, "offset": off + 60, "size": size})
        off += 60 + size + (size % 2)
    return members


