# =============================================================================
#  THADD OS portal — nginx edge (rendered by entrypoint, ${PORT} from env)
#  Serves: branded portal, noVNC client, live credentials API and the
#  WebSocket bridge into the running desktop.
# =============================================================================
server {
    listen ${PORT} default_server;
    server_name _;

    root /opt/thadd/web;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Health endpoint used by Railway and Docker healthchecks
    location = /healthz {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"status":"ok","service":"thadd-os","version":"1.0.0"}\n';
    }

    # Live credentials (regenerated by entrypoint at every boot)
    location = /api/creds {
        alias /opt/thadd/credentials.json;
        default_type application/json;
        add_header Cache-Control "no-store";
    }

    # noVNC web client
    location /vnc/ {
        alias /usr/share/novnc/;
        index vnc.html;
        add_header Cache-Control "public, max-age=3600";
    }

    # WebSocket bridges into the persistent desktop (Xvnc :1)
    location = /websockify {
        proxy_pass http://127.0.0.1:6080/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
    location = /vnc/websockify {
        proxy_pass http://127.0.0.1:6080/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # Branded portal
    location / {
        try_files $uri $uri/ =404;
    }

    client_max_body_size 50m;
}
